# Fastlane Fastfile — Pharmascan (Scan Cashback)
# Lanes : build + upload Play Store (track interne / production)
default_platform(:android)

platform :android do
  desc "Build AAB et upload vers le track interne"
  lane :deploy_internal do
    # 1. Build de l'AAB signé via Flutter (clé : android/key.properties + keystore)
    #    flutter place l'AAB dans build/app/outputs/bundle/release/
    sh("flutter", "build", "appbundle", "--release")

    # 2. Upload vers Play Console — track interne
    supply(
      aab: "build/app/outputs/bundle/release/app-release.aab",
      track: "internal",
      skip_upload_apk: true,
      skip_upload_aab: false,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Build AAB et upload vers le track production"
  lane :deploy_production do
    sh("flutter", "build", "appbundle", "--release")

    supply(
      aab: "build/app/outputs/bundle/release/app-release.aab",
      track: "production",
      skip_upload_apk: true,
      skip_upload_aab: false,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
