<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : le splash système affiche le design complet en fond
     (windowSplashScreenBackground) et masque l'icône par défaut
     (windowSplashScreenAnimatedIcon transparent) → pas de double logo. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@drawable/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/transparent_icon</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
