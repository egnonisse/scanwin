<?xml version="1.0" encoding="utf-8"?>
<!-- Écran de lancement natif : fond blanc + logo centré (le logo est vert
     foncé — sur fond vert il serait illisible). Transition parfaite avec le
     splash Flutter (fond clair). Affiché dès la première milliseconde. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/logo_splash" />
    </item>
</layer-list>
