rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Administrateurs : identifiés par leur email Firebase Auth.
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email in ['egnonisse@gmail.com', 'tobossinonleonard@gmail.com'];
    }

    // Photos en attente (uploadées par l'app avant soumission) :
    // seul le propriétaire écrit/supprime, l'admin peut lire.
    match /pending/{uid}/{fileName} {
      allow read: if isAdmin();
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Photos finales des reçus (déplacées par la Cloud Function) :
    // lecture admin uniquement (privacy), écriture CF (admin SDK).
    match /receipts/{fileName} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Images des campagnes (bannières) : upload admin, lecture publique
    // pour les utilisateurs connectés (affichage dans l'app).
    match /campaignImages/{fileName} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Images des annonces (popups) : upload admin, lecture utilisateurs.
    match /announcementImages/{fileName} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
