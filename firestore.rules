rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Administrateurs : identifiés par leur email Firebase Auth.
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email in ['egnonisse@gmail.com'];
    }

    // Archives des reçus : écrites par la Cloud Function (admin SDK).
    // Lecture et suppression réservées à l'admin (modération).
    match /receipts/{receiptId} {
      allow read: if isAdmin();
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    // Table de recherche des prix : lue par les utilisateurs authentifiés
    // (recherche médicament), écrite par la Cloud Function,
    // supprimée par l'admin (modération en cascade).
    match /priceEntries/{entryId} {
      allow read: if request.auth != null;
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    // Pharmacies : lues par les utilisateurs connectés (app),
    // gérées par l'admin (CRUD + dates de garde).
    match /pharmacies/{pharmacyId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Profil utilisateur : le client ne peut créer que son propre profil
    // avec points == 0, et ne peut modifier QUE currencyCode.
    // points / createdAt / pointsEvents sont gérés par la Cloud Function.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['points', 'currencyCode', 'createdAt'])
          && request.resource.data.points == 0
          && request.resource.data.currencyCode is string;

      allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currencyCode']);

      allow delete: if false;
    }

    // Historique des points : lecture par le propriétaire uniquement,
    // écriture par la Cloud Function uniquement.
    match /users/{userId}/pointsEvents/{eventId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
